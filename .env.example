# Copy to .env (gitignored) and fill in your sauna's details.

# BLE MAC address of your sauna's controller.
# Find it with:  bluetoothctl scan on   (look for a 'Sauna' device)
# or the nRF Connect phone app. If left blank, the scripts scan by name below.
CALDERA_SAUNA_ADDRESS=AA:BB:CC:DD:EE:FF

# Substring to match on the advertised name when no address is set.
CALDERA_SAUNA_NAME=Sauna
